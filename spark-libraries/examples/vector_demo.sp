$import "../modules/vector.sp"

fn main()
    let opened = vec_begin("spark-vector-demo.svg", 640, 420)
    if opened < 0
        print("Could not create SVG. errno=" + str(vec_last_error()))
        return

    vec_background("#101827")
    vec_circle(320, 190, 115, "#0ea5e9")
    vec_circle_outline(320, 190, 115, "#bae6fd", 6)
    vec_ellipse(320, 215, 72, 38, "#082f49")
    vec_rect(170, 330, 300, 8, "#38bdf8")
    vec_rect_outline(160, 320, 320, 28, "#e0f2fe", 2)
    vec_line(80, 70, 560, 70, "#64748b", 2)
    vec_line(80, 85, 560, 85, "#334155", 1)
    vec_path("M 265 160 Q 320 105 375 160", "#ffffff", "none", 7)
    vec_circle(285, 185, 9, "#ffffff")
    vec_circle(355, 185, 9, "#ffffff")
    vec_text(220, 55, 25, "#f8fafc", "SPARK VECTOR")
    vec_text(238, 385, 16, "#bae6fd", "SVG generated by Spark")
    vec_end()
    print("Created spark-vector-demo.svg")
